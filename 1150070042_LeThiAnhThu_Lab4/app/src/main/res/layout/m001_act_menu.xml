<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <View
        android:id="@+id/center_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp" />

    <ImageView
        android:id="@+id/iv_center_zodiac"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_zodiac_default"
        app:layout_constraintTop_toTopOf="@id/center_anchor"
        app:layout_constraintBottom_toBottomOf="@id/center_anchor"
        app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintEnd_toEndOf="@id/center_anchor"
        android:translationY="-40dp"
        android:contentDescription="Icon Cung đang chọn" />

    <ImageView android:id="@+id/iv_zodiac_1" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/bachduong"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="30" android:contentDescription="Cung 1" />
    <ImageView android:id="@+id/iv_zodiac_2" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/kimnguu"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="60" android:contentDescription="Cung 2" />
    <ImageView android:id="@+id/iv_zodiac_3" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/songtu"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="90" android:contentDescription="Cung 3" />
    <ImageView android:id="@+id/iv_zodiac_4" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/cugiai"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="120" android:contentDescription="Cung 4" />
    <ImageView android:id="@+id/iv_zodiac_5" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/sutu"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="150" android:contentDescription="Cung 5" />
    <ImageView android:id="@+id/iv_zodiac_6" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/xunu"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="180" android:contentDescription="Cung 6" />
    <ImageView android:id="@+id/iv_zodiac_7" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/thienbinh"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="210" android:contentDescription="Cung 7" />
    <ImageView android:id="@+id/iv_zodiac_8" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/bocap"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="240" android:contentDescription="Cung 8" />
    <ImageView android:id="@+id/iv_zodiac_9" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/nhanma"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="270" android:contentDescription="Cung 9" />
    <ImageView android:id="@+id/iv_zodiac_10" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/maket"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="300" android:contentDescription="Cung 10" />
    <ImageView android:id="@+id/iv_zodiac_11" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/baobinh"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="330" android:contentDescription="Cung 11" />
    <ImageView android:id="@+id/iv_zodiac_12" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/songngu"
        app:layout_constraintTop_toTopOf="@id/center_anchor" app:layout_constraintStart_toStartOf="@id/center_anchor"
        app:layout_constraintCircle="@id/center_anchor" app:layout_constraintCircleRadius="100dp" app:layout_constraintCircleAngle="0" android:contentDescription="Cung 12" />

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:background="@android:color/white"
        android:paddingTop="50dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/center_anchor"
        app:layout_constraintBottom_toTopOf="@id/btn_xem_them"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_zodiac_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/zodiac_blue"
                android:text="Chọn một cung để xem thông tin" />

            <TextView
                android:id="@+id/tv_zodiac_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:text="Ngày sinh: --/-- đến --/--" />

            <TextView
                android:id="@+id/tv_zodiac_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:textAlignment="center"
                android:text="Thông tin tóm tắt về cung sẽ hiển thị ở đây." />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_xem_them"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Xem Thêm Chi Tiết"
        android:backgroundTint="@color/zodiac_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>